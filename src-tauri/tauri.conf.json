{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ответошная",
  "mainBinaryName": "otvetoshnaya",
  "version": "../package.json",
  "identifier": "ru.gkb24.otvetoshnaya",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-page.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Отзывы ГКБ №24",
    "copyright": "ГКБ №24",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NTkyODgxQTE2MkY2QkYKUldTLzltS2hnU2haSjF0ZU9ka0pLQ2xDUGRIQlRNcFVudEg1eTZlMVp6TitDYlNnanl6TWd1KzMK",
      "endpoints": [
        "https://raw.githubusercontent.com/hellatarantella/otvetoshnaya-releases/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}