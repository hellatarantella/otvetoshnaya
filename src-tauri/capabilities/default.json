{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: данные программы, загрузки, обновления, управление окнами кабинетов",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-db-load",
    "allow-db-save",
    "allow-asset-put",
    "allow-asset-delete",
    "allow-save-download",
    "allow-app-info",
    "allow-update-check",
    "allow-update-install",
    "allow-source-open",
    "allow-source-collect",
    "allow-source-close",
    "allow-source-allow",
    "allow-source-stop",
    "allow-model-status",
    "allow-model-download",
    "allow-model-delete",
    "allow-model-generate",
    "allow-gs-call",
    "allow-log-append",
    "allow-log-read"
  ]
}